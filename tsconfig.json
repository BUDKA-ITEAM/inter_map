{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": true,
    "rootDir": "src/ts",
    "outDir": "src/front",
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["src/ts/**/*.ts"]
}
